      <title>دليل لينكس للمبتدئين</title>
      <link>http://localhost:1313/my-arabicj-blog/posts/%D9%84%D9%8A%D9%86%D9%83%D8%B3-%D9%84%D9%84%D9%85%D8%A8%D8%AA%D8%AF%D8%A6%D9%8A%D9%86/</link>
