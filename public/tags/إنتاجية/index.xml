    <item>
      <title>أفضل الأدوات للمطورين</title>
      <link>http://localhost:1313/reponame/posts/%D8%A3%D8%AF%D9%88%D8%A7%D8%AA-%D9%85%D8%B7%D9%88%D8%B1/</link>
